{
  "name": "@omniops/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "OmniOps customer mobile app (Expo React Native) — QR/link survey taking",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "export:ios": "expo export --platform ios --output-dir dist/export-ios",
    "export:android": "expo export --platform android --output-dir dist/export-android"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@omniops/shared": "workspace:*",
    "expo": "~52.0.0",
    "expo-font": "~13.0.4",
    "react": "18.3.1",
    "react-native": "0.76.0"
  },
  "devDependencies": {
    "@types/react": "~18.3.0",
    "typescript": "~5.5.0"
  }
}
